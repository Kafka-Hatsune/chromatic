index 0000000..5bbd9f4
--- /dev/null
+++ b/src/kanji-host.js
@@ -0,0 +1,16 @@
+// An isolated local origin avoids changing the host application's CSP.
+// Accept one private MessagePort from the embedding CloudMusic window.
+let connected = false;
+window.addEventListener('message', event => {
+    if (connected || event.source !== parent || event.data?.type !== 'rnp-kanji-connect' || !event.ports[0]) return;
+    connected = true;
+    const port = event.ports[0];
+    try {
+        const worker = new Worker('kanji-worker.js');
+        worker.onmessage = ({ data }) => port.postMessage(data);
+        worker.onerror = event => port.postMessage({ type: 'error', error: event.message });
+        port.onmessage = ({ data }) => worker.postMessage(data, data.buffer ? [data.buffer] : []);
+        window.addEventListener('unload', () => worker.terminate());
+        port.postMessage({ type: 'ready' });
+    } catch (error) { port.postMessage({ type: 'error', error: String(error.message || error) }); }
+});
diff --git a/src/kanji-model.cjs b/src/kanji-model.cjs
new file mode 100644
index 0000000..160659a
--- /dev/null
+++ b/src/kanji-model.cjs
@@ -0,0 +1,52 @@
+// Shared by the renderer, worker and tests. Never change the lyric's source text.
+const hasKana = text => /[ぁ-ゖァ-ヺ]/.test(text);
+const hasKanji = text => /[々〇一-鿿㐀-䶿豈-﫿]/.test(text);
+const onlyKanji = text => /^[々〇一-鿿㐀-䶿豈-﫿]+$/.test(text);
+const isCredit = text => /^(作词|作曲|编曲|作詞|作曲|編曲|歌手|制作|製作|混音|录音|演唱|词|曲|Lyric|Music|Vocal|Arrange|Compose|Produce|Mix|Master)\s*[:：/]/i.test(text.trim());
+
+function readingRequests(lines) {
+    // Kana is evidence for Japanese; Chinese songs must not get Japanese readings.
+    const content = lines.filter(line => line.originalLyric && !isCredit(line.originalLyric));
+    const kanaLines = content.filter(line => hasKana(line.originalLyric)).length;
+    const japaneseSong = kanaLines >= 2 && kanaLines >= content.length * 0.35;
+    return lines.map(line => {
+        const text = line.originalLyric || '';
+        const eligible = !isCredit(text) && (hasKana(text) || (japaneseSong && hasKanji(text)));
+        return eligible ? { text, karaoke: line.dynamicLyric?.map(word => word.word).join('') || text, roman: line.romanLyric || '' } : null;
+    });
+}
+
+function hasReadings(line) {
+    return !!line.kanjiReading?.original?.some(segment => segment.romaji);
+}
+
+function useKanjiReading(line, mode, showRomaji) {
+    return showRomaji && mode !== 'off' && !!line.kanjiReading;
+}
+
+// A compound can cover multiple timed words (世 + 界). Keep its reading together
+// and retain each word's original index/timing inside the compound.
+function karaokeGroups(words, segments) {
+    const text = words.map(word => word.word).join('');
+    if (!segments || segments.map(segment => segment.text).join('') !== text) {
+        return words.map((word, index) => ({ parts: [{ text: word.word, index, final: true }] }));
+    }
+    const groups = [];
+    let wordIndex = 0, wordOffset = 0;
+    for (const segment of segments) {
+        const parts = [];
+        let offset = 0;
+        while (offset < segment.text.length && wordIndex < words.length) {
+            const word = words[wordIndex].word;
+            const length = Math.min(segment.text.length - offset, word.length - wordOffset);
+            if (length > 0) parts.push({ text: segment.text.slice(offset, offset + length), index: wordIndex, final: wordOffset + length === word.length });
+            offset += length;
+            wordOffset += length;
+            if (wordOffset === word.length) { wordIndex++; wordOffset = 0; }
+        }
+        groups.push({ ...segment, parts });
+    }
+    return groups;
+}
+
+module.exports = { hasKana, hasKanji, onlyKanji, readingRequests, hasReadings, useKanjiReading, karaokeGroups };
diff --git a/src/kanji-reader.js b/src/kanji-reader.js
new file mode 100644
index 0000000..122160e
--- /dev/null
+++ b/src/kanji-reader.js
@@ -0,0 +1,102 @@
+import { readingRequests } from './kanji-model.cjs';
+
+const dictionaryFiles = new Set(['base', 'check', 'cc', 'tid', 'tid_pos', 'tid_map', 'unk', 'unk_pos', 'unk_map', 'unk_char', 'unk_compat', 'unk_invoke'].map(name => `${name}.dat.gz`));
+let worker, boot, sequence = 0, generation = 0, retryAfter = 0;
+const pending = new Map();
+
+export function cancelKanjiReadings() {
+    for (const request of pending.values()) {
+        clearTimeout(request.timer);
+        request.resolve(null);
+    }
+    pending.clear();
+}
+
+export function disposeKanjiReader() {
+    generation++;
+    cancelKanjiReadings();
+    worker?.terminate();
+    worker = null;
+    boot = null;
+}
+
+function fail(error) {
+    console.warn('[RNP kanji] Reading engine unavailable; original lyrics remain available.', error);
+    disposeKanjiReader();
+    retryAfter = Date.now() + 60000;
+}
+
+async function ensureWorker() {
+    if (Date.now() < retryAfter) return null;
+    if (worker) return worker;
+    if (boot) return boot;
+    const epoch = generation;
+    boot = (async () => {
+        const root = plugin.pluginPath;
+        // CloudMusic 3.1.41's CSP disallows blob Workers in the orpheus page.
+        // A same-origin local Worker in a hidden mounted page needs no CSP changes.
+        const mounted = await betterncm.fs.mountDir(root);
+        if (epoch !== generation) return null;
+        const frame = document.createElement('iframe');
+        frame.hidden = true;
+        frame.title = 'RNP local Japanese reading worker';
+        frame.setAttribute('sandbox', 'allow-scripts allow-same-origin');
+        const channel = new MessageChannel();
+        const instance = {
+            postMessage: (data, transfer = []) => channel.port1.postMessage(data, transfer),
+            terminate: () => { channel.port1.close(); frame.remove(); },
+        };
+        worker = instance;
+        let markReady;
+        const ready = new Promise(resolve => { markReady = resolve; });
+        channel.port1.onmessage = async ({ data }) => {
+            if (worker !== instance) return;
+            if (data.type === 'ready') { markReady(instance); return; }
+            if (data.type === 'error') { fail(data.error); markReady(null); return; }
+            if (data.type === 'dictionary') {
+                try {
+                    if (!dictionaryFiles.has(data.name)) throw new Error('Unknown dictionary file');
+                    const blob = await betterncm.fs.readFile(`${root}/dict/${data.name}`);
+                    const buffer = await blob.arrayBuffer();
+                    if (worker === instance) instance.postMessage({ type: 'dictionary', id: data.id, buffer }, [buffer]);
+                } catch (error) {
+                    if (worker === instance) instance.postMessage({ type: 'dictionary', id: data.id, error: String(error.message || error) });
+                }
+                return;
+            }
+            if (data.type !== 'result') return;
+            const request = pending.get(data.id);
+            if (!request) return;
+            if (data.error) { fail(data.error); return; }
+            pending.delete(data.id);
+            clearTimeout(request.timer);
+            request.resolve(data.result);
+        };
+        frame.onload = () => {
+            if (worker === instance) frame.contentWindow.postMessage({ type: 'rnp-kanji-connect' }, new URL(mounted).origin, [channel.port2]);
+        };
+        frame.onerror = () => { if (worker === instance) fail('Reading worker host failed to load'); markReady(null); };
+        frame.src = `${mounted}/kanji-host.html`;
+        document.body.appendChild(frame);
+        return ready;
+    })().catch(error => { fail(error); return null; });
+    return boot;
+}
+
+export async function addKanjiReadings(lines) {
+    const requests = readingRequests(lines);
+    if (!requests.some(Boolean)) return null;
+    // Include bootstrap/file reads in the timeout, and discard outdated song jobs.
+    cancelKanjiReadings();
+    const id = ++sequence;
+    return new Promise(resolve => {
+        const timer = setTimeout(() => fail('Reading engine timed out'), 30000);
+        pending.set(id, { resolve: result => resolve(result && lines.map((line, index) => result[index] ? { ...line, kanjiReading: result[index] } : line)), timer });
+        ensureWorker().then(instance => {
+            if (!pending.has(id)) return;
+            if (!instance) { cancelKanjiReadings(); return; }
+            instance.postMessage({ type: 'analyze', id, lines: requests });
+        }).catch(error => { if (pending.has(id)) fail(error); });
+    });
+}
+window.addEventListener('beforeunload', disposeKanjiReader);
diff --git a/src/kanji-ruby.js b/src/kanji-ruby.js
