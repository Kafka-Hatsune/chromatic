index 0000000..3e97895
--- /dev/null
+++ b/src/kanji-engine.cjs
@@ -0,0 +1,21 @@
+const core = require('../vendor/japanese/furigana.js');
+const { toRomaji } = require('wanakana');
+const { hasKanji, onlyKanji } = require('./kanji-model.cjs');
+
+function analyzeText(tokenizer, text, roman = '') {
+    if (!hasKanji(text) || core.isCreditLine(text) || text.length > 1000) return [{ text }];
+    const dictionary = core.tokensToSegments(tokenizer.tokenize(text));
+    if (dictionary.map(segment => segment.text).join('') !== text) return [{ text }];
+    const kana = roman && core.romajiToKana(roman);
+    const supplied = kana && core.segmentsFromReading(text, kana, dictionary);
+    const segments = supplied || dictionary;
+    return segments.map(segment => {
+        // Do not spread a whole-word reading over kana or numbers on failed alignment.
+        // Keep author-supplied parenthetical text; only annotation is added.
+        if (!segment.rt || !onlyKanji(segment.text)) return { text: segment.text };
+        const romaji = toRomaji(segment.rt);
+        if (!/^[a-z' -]+$/i.test(romaji)) return { text: segment.text };
+        return { text: segment.text, hiragana: core.toHiragana(segment.rt), romaji, source: segment.fixed ? 'inline' : supplied ? 'lyric' : 'dictionary' };
+    });
+}
+module.exports = { analyzeText };
