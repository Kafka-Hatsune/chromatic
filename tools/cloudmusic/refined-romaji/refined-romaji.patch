+++ b/src/kanji-ruby.js
@@ -0,0 +1,24 @@
+import { karaokeGroups } from './kanji-model.cjs';
+
+function Ruby({ segment, mode, children }) {
+    const reading = mode === 'hiragana' ? segment.hiragana : segment.romaji;
+    return reading ? <ruby className="rnp-kanji-ruby"><span className="rnp-kanji-base">{children}</span><rt>{reading}</rt></ruby> : <React.Fragment>{children}</React.Fragment>;
+}
+
+export function KanjiText({ text, segments, mode }) {
+    if (!segments || mode === 'off') return text;
+    return segments.map((segment, index) => <Ruby key={index} segment={segment} mode={mode}>{segment.text}</Ruby>);
+}
+
+export function KanjiKaraoke({ words, segments, mode, animation, wordStyle, fillerStyle }) {
+    const groups = React.useMemo(() => karaokeGroups(words, mode === 'off' ? null : segments), [words, segments, mode]);
+    return groups.map((group, groupIndex) => <Ruby key={groupIndex} segment={group} mode={mode}>{group.parts.map(part => {
+        const word = words[part.index];
+        return <span key={`${part.index}-${part.final}`} data-word-index={part.index}
+            className={`rnp-karaoke-word ${word.isCJK ? 'is-cjk' : ''} ${word.endsWithSpace && part.final ? 'end-with-space' : ''}`}
+            style={wordStyle(word)}>
+            <span>{part.text}</span>
+            {animation === 'slide' && <span className="rnp-karaoke-word-filler" style={fillerStyle(word)}>{part.text}</span>}
+        </span>;
+    })}</Ruby>);
+}
diff --git a/src/kanji-worker.js b/src/kanji-worker.js
new file mode 100644
index 0000000..9b5686d
--- /dev/null
+++ b/src/kanji-worker.js
@@ -0,0 +1,50 @@
+// Dictionary decompression, tokenization and reading alignment stay off the UI thread.
+const kuromoji = require('../vendor/japanese/kuromoji.js');
+const { analyzeText } = require('./kanji-engine.cjs');
+let dictionarySequence = 0;
+const dictionaryRequests = new Map();
+globalThis.__FURIGANA_DICT_LOADER__ = path => new Promise((resolve, reject) => {
+    const id = ++dictionarySequence;
+    dictionaryRequests.set(id, { resolve, reject });
+    self.postMessage({ type: 'dictionary', id, name: path.split('/').pop() });
+});
+let tokenizerPromise;
+const getTokenizer = () => tokenizerPromise ||= new Promise((resolve, reject) => {
+    kuromoji.builder({ dicPath: 'dict' }).build((error, tokenizer) => error ? reject(error) : resolve(tokenizer));
+});
+let latestRequest = 0;
+const cache = new Map();
+function analyzeCached(tokenizer, text, roman) {
+    const key = JSON.stringify([text, roman]);
+    if (cache.has(key)) return cache.get(key);
+    const result = analyzeText(tokenizer, text, roman);
+    if (cache.size >= 600) cache.delete(cache.keys().next().value);
+    cache.set(key, result);
+    return result;
+}
+self.onmessage = async ({ data }) => {
+    if (data.type === 'dictionary') {
+        const request = dictionaryRequests.get(data.id);
+        dictionaryRequests.delete(data.id);
+        if (request) data.error ? request.reject(new Error(data.error)) : request.resolve(data.buffer);
+        return;
+    }
+    if (data.type !== 'analyze') return;
+    latestRequest = data.id;
+    try {
+        const tokenizer = await getTokenizer();
+        const result = [];
+        for (const line of data.lines) {
+            if (data.id !== latestRequest) return;
+            result.push(line ? {
+                original: analyzeCached(tokenizer, line.text, line.roman),
+                karaoke: analyzeCached(tokenizer, line.karaoke, line.roman),
+            } : null);
+            // Accept newer song requests between lines.
+            await new Promise(resolve => setTimeout(resolve, 0));
+        }
+        self.postMessage({ type: 'result', id: data.id, result });
+    } catch (error) {
+        self.postMessage({ type: 'result', id: data.id, error: String(error.message || error) });
+    }
+};
