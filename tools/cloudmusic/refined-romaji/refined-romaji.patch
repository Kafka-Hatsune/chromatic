diff --git a/tools/test-kanji.cjs b/tools/test-kanji.cjs
new file mode 100644
index 0000000..24527bf
--- /dev/null
+++ b/tools/test-kanji.cjs
@@ -0,0 +1,74 @@
+const assert = require('node:assert/strict');
+const { test, before } = require('node:test');
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { Worker } = require('node:worker_threads');
+const { analyzeText } = require('../src/kanji-engine.cjs');
+const { onlyKanji, readingRequests, karaokeGroups, useKanjiReading } = require('../src/kanji-model.cjs');
+
+let tokenizer;
+before(async () => {
+    globalThis.__FURIGANA_DICT_LOADER__ = async file => {
+        const data = await fs.readFile(file);
+        return data.buffer.slice(data.byteOffset, data.byteOffset + data.byteLength);
+    };
+    tokenizer = await new Promise((resolve, reject) => require('../vendor/japanese/kuromoji.js').builder({ dicPath: path.join(__dirname, '../vendor/japanese/dict') }).build((error, result) => error ? reject(error) : resolve(result)));
+});
+test('offline readings preserve every character and annotate only kanji', () => {
+    for (const text of ['世界に行こう', '持ち帰る', '愛がゆえに', '食べる', 'こんにちは', 'Hello 世界！', '1人で行く', '10年後に会う', '宇宙（そら）へ行く', '𠮷野へ行く']) {
+        const segments = analyzeText(tokenizer, text);
+        assert.equal(segments.map(segment => segment.text).join(''), text);
+        assert.ok(segments.every(segment => !segment.romaji || onlyKanji(segment.text)));
+    }
+    assert.equal(analyzeText(tokenizer, '世界に行こう').find(s => s.text === '世界').romaji, 'sekai');
+    const split = analyzeText(tokenizer, '持ち帰る');
+    assert.equal(split.find(s => s.text === '持').romaji, 'mo');
+    assert.equal(split.find(s => s.text === '帰').romaji, 'kae');
+    assert.equal(analyzeText(tokenizer, '愛がゆえに')[0].romaji, 'ai');
+});
+test('official singing readings take precedence, malformed readings fall back', () => {
+    assert.equal(analyzeText(tokenizer, '宇宙へ', 'so ra e')[0].romaji, 'sora');
+    assert.equal(analyzeText(tokenizer, '世界へ', 'invalid!!!')[0].romaji, 'sekai');
+    assert.equal(analyzeText(tokenizer, '宇宙（そら）へ')[0].romaji, 'sora');
+});
+test('Chinese translations and non-Japanese songs do not enter the engine', () => {
+    const chinese = [{ originalLyric: '这是我们的世界', translatedLyric: '世界に行こう' }, { originalLyric: '你好世界' }];
+    assert.deepEqual(readingRequests(chinese), [null, null]);
+    const lines = [{ originalLyric: '世界へ' }, { originalLyric: 'あなたに' }, { originalLyric: '未来' }, { originalLyric: '作詞：誰か' }];
+    assert.deepEqual(readingRequests(lines).map(Boolean), [true, true, true, false]);
+    assert.equal(useKanjiReading({ kanjiReading: {} }, 'off', true), false);
+    assert.equal(useKanjiReading({ kanjiReading: {} }, 'romaji', false), false);
+});
+test('compound ruby crosses YRC word boundaries without changing timing indices', () => {
+    const words = [{ word: '世', time: 100 }, { word: '界へ行', time: 200 }, { word: 'く', time: 300 }];
+    const groups = karaokeGroups(words, analyzeText(tokenizer, words.map(w => w.word).join('')));
+    const world = groups.find(group => group.romaji === 'sekai');
+    assert.deepEqual(world.parts.map(part => [part.text, part.index]), [['世', 0], ['界', 1]]);
+    assert.equal(groups.flatMap(group => group.parts).map(part => part.text).join(''), '世界へ行く');
+    assert.deepEqual(groups.flatMap(group => group.parts).filter(part => part.final).map(part => part.index), [0, 1, 2]);
+    assert.equal(karaokeGroups(words, [{ text: 'different', romaji: 'wrong' }]).length, words.length);
+});
+test('production worker loads local dictionaries and ignores stale song requests', async () => {
+    const worker = new Worker(`const {parentPort}=require('node:worker_threads'); global.self=globalThis; global.postMessage=(data)=>parentPort.postMessage(data); parentPort.on('message', data=>self.onmessage({data})); require(${JSON.stringify(path.join(__dirname, '../dist/kanji-worker.js'))});`, { eval: true });
+    try {
+        const messages = [];
+        const response = new Promise((resolve, reject) => {
+            worker.on('error', reject);
+            worker.on('message', async data => {
+                if (data.type === 'dictionary') {
+                    const bytes = await fs.readFile(path.join(__dirname, '../vendor/japanese/dict', data.name));
+                    const buffer = bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength);
+                    worker.postMessage({ type: 'dictionary', id: data.id, buffer }, [buffer]);
+                } else { messages.push(data); resolve(data); }
+            });
+        });
+        worker.postMessage({ type: 'analyze', id: 1, lines: [{ text: '古い歌へ', karaoke: '古い歌へ', roman: '' }] });
+        worker.postMessage({ type: 'analyze', id: 2, lines: [{ text: '世界へ', karaoke: '世界へ', roman: '' }, null] });
+        const result = await response;
+        assert.equal(result.id, 2);
+        assert.equal(result.error, undefined);
+        assert.equal(result.result[0].original[0].romaji, 'sekai');
+        assert.equal(result.result[1], null);
+        assert.equal(messages.length, 1);
+    } finally { await worker.terminate(); }
+});
